# ==============================================
# AI AGENT BACKEND CONFIGURATION
# ==============================================
# Copy file ini ke .env dan isi dengan nilai Anda

# ===== SERVER CONFIGURATION =====
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ===== ANTHROPIC API =====
ANTHROPIC_API_KEY=sk-ant-xxxxx

# ===== SLACK (Optional) =====
SLACK_BOT_TOKEN=xoxb-xxxxx
SLACK_APP_TOKEN=xapp-xxxxx

# ===== DATABASE (Optional) =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_agent_db
DB_USER=postgres
DB_PASSWORD=password

# ===== API KEYS (Optional) =====
SEARCH_API_KEY=xxxxx
CUSTOM_API_BASE_URL=https://api.example.com
CUSTOM_API_KEY=xxxxx
