{
  "schemaVersion": "1.0",
  "version": "3.0.0",
  "id": "meta-workspace",
  "description": "Workspace configurations and capability mapping",
  "owner": "mamet-os",
  "updatedAt": "2026-07-05T00:00:00Z",
  "workspaces": [
    {
      "id": "global",
      "name": "Global",
      "capabilities": ["cap:core-apps", "cap:settings", "cap:observability"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true }
    },
    {
      "id": "ws-owner",
      "name": "Owner Workspace",
      "capabilities": ["cap:core-apps"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true }
    },
    {
      "id": "ws-lite",
      "name": "Lite Workspace",
      "capabilities": ["cap:lite"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true, "read_only_memory": true }
    },
    {
      "id": "ws-engineer",
      "name": "Engineer Workspace",
      "capabilities": ["cap:engineer"],
      "default_layout": { "left_workbench": ["widget:engineering-tasks", "widget:architecture-gaps"], "right_workbench": ["widget:verification-log"], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": false }
    },
    {
      "id": "ws-knowledge",
      "name": "Knowledge Workspace",
      "capabilities": ["cap:knowledge"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true }
    },
    {
      "id": "ws-memory",
      "name": "Memory Workspace",
      "capabilities": ["cap:knowledge"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true }
    },
    {
      "id": "ws-agent-forge",
      "name": "Agent Forge Workspace",
      "capabilities": ["cap:core-apps"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "allow_global_memory": true }
    }
  ],
  "appToCapability": {
    "app:home": "cap:core-apps",
    "app:assistant": "cap:core-apps",
    "app:mametlite": "cap:lite",
    "app:engineer": "cap:engineer",
    "app:knowledge-base": "cap:knowledge",
    "app:memory-graph": "cap:knowledge",
    "app:agent-forge": "cap:core-apps",
    "app:settings": "cap:settings",
    "app:verification": "cap:observability",
    "app:event-stream": "cap:observability",
    "app:kernel": "cap:observability"
  }
}
