{
  "schemaVersion": "1.0",
  "version": "3.0.0",
  "id": "meta-workspace",
  "description": "Workspace configurations and capability mapping",
  "owner": "mamet-os",
  "updatedAt": "2026-07-05T00:00:00Z",
  "workspaces": [
    {
      "id": "global",
      "name": "Global",
      "capabilities": ["cap:core-apps", "cap:settings", "cap:observability"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "read_scope": "all", "write_scope": "all", "tools_access": "full" }
    },
    {
      "id": "ws-assistant",
      "name": "Assistant Workspace",
      "capabilities": ["cap:core-apps"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "read_scope": "all", "write_scope": "all", "tools_access": "full" }
    },
    {
      "id": "ws-lite",
      "name": "Lite Workspace",
      "capabilities": ["cap:lite"],
      "default_layout": { "left_workbench": [], "right_workbench": [], "bottom_workbench": [] },
      "permissions": { "read_scope": "essential", "write_scope": "limited", "tools_access": "minimal" }
    },
    {
      "id": "ws-engineer",
      "name": "Engineer Workspace",
      "capabilities": ["cap:engineer"],
      "default_layout": { 
        "left_workbench": [], 
        "right_workbench": [], 
        "bottom_workbench": [] 
      },
      "permissions": { "read_scope": "all", "write_scope": "engineering_only", "tools_access": "engineer_only" }
    }
  ],
  "appToCapability": {
    "app:home": "cap:core-apps",
    "app:assistant": "cap:core-apps",
    "app:mametlite": "cap:lite",
    "app:engineer": "cap:engineer",
    "app:knowledge-base": "cap:knowledge",
    "app:memory-graph": "cap:knowledge",
    "app:agent-forge": "cap:core-apps",
    "app:settings": "cap:settings"
  }
}
