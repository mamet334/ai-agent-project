{
  "name": "ai-agent-frontend",
  "version": "4.1.3",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "postbuild": "node -e \"const fs=require('fs'); let h=fs.readFileSync('dist/index.html','utf8'); h=h.replaceAll(' crossorigin',''); h=h.replace(/<meta http-equiv=.Content-Security-Policy.[^>]*>/,''); fs.writeFileSync('dist/index.html',h); console.log('Post-build: crossorigin + CSP stripped from dist/index.html')\"",
    "dist": "vite build && npm run postbuild && electron-builder --win",
    "dist:portable": "vite build && npm run postbuild && electron-builder --win portable",
    "dist:publish": "vite build && npm run postbuild && electron-builder --win --publish always"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.6.0",
    "deno-bin": "^2.2.7",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "file-saver": "^2.0.5",
    "ghost-cursor": "^1.4.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "puppeteer": "^25.1.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-recaptcha": "^3.6.8",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2",
    "postcss": "^8.4.31",
    "rollup-obfuscator": "^4.1.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.mametdev.mamet-ai",
    "productName": "Mamet AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mamet AI"
    },
    "portable": {
      "artifactName": "MametAI-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mamet334",
      "repo": "mamet-ai-releases"
    }
  }
}
