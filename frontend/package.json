{
  "name": "ai-agent-frontend",
  "version": "1.0.6",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env NODE_ENV=development electron .",
    "desktop": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && npm run electron:dev\"",
    "dist": "vite build && powershell -Command \"(Get-Content dist\\index.html) -replace ' crossorigin', '' | Set-Content dist\\index.html\" && electron-builder --win",
    "dist:portable": "vite build && powershell -Command \"(Get-Content dist\\index.html) -replace ' crossorigin', '' | Set-Content dist\\index.html\" && electron-builder --win portable",
    "dist:publish": "vite build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/typography": "^0.5.19",
    "axios": "^1.6.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.3.9",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.383.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2",
    "postcss": "^8.4.31",
    "rollup-obfuscator": "^4.1.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.mametdev.mamet-ai",
    "productName": "Mamet AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mamet AI"
    },
    "portable": {
      "artifactName": "MametAI-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "mamet334",
      "repo": "ai-agent-project"
    }
  }
}